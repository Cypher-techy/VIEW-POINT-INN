{
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__path=$1" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,site.config.json,public/img/manifest.json}",
      "maxDuration": 15
    }
  },
  "headers": [
    { "source": "/(img|fonts)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
